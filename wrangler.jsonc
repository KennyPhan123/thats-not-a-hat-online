{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thats-not-a-hat",
  "main": "party/server.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/parties/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "GameServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameServer"] }]
}
